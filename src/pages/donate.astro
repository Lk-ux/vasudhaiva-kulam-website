---
import BaseLayout from "../layouts/BaseLayout.astro";

const upiId = "120040147960@cnrb";
const payeeName = "VASUDHAIVA KULAM TRUST";
const merchantCode = "8398";
const currency = "INR";
const defaultAmounts = [100, 500, 1000, 2500];
---

<BaseLayout title="Donate | Vasudhaiva Kulam Trust">
  <main class="mx-auto max-w-5xl px-5 py-10 sm:px-8">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-semibold text-orange-700 hover:text-orange-900"
    >
      <span aria-hidden="true">←</span> Back to website
    </a>

    <section
      class="mt-8 overflow-hidden rounded-3xl bg-white shadow-xl ring-1 ring-orange-100"
    >
      <div
        class="bg-gradient-to-br from-orange-600 via-amber-500 to-yellow-400 px-6 py-10 text-white sm:px-10"
      >
        <p class="text-sm font-bold uppercase tracking-widest">
          Vasudhaiva Kulam Trust
        </p>
        <h1 class="mt-3 text-3xl font-extrabold sm:text-5xl">
          Support our work
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-white/90 sm:text-lg">
          Your contribution helps Vasudhaiva Kulam Trust continue its charitable
          and community work.
        </p>
      </div>

      <div class="grid gap-10 p-6 sm:p-10 lg:grid-cols-[1.1fr_.9fr]">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Donate by UPI</h2>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <button
              id="copy-button"
              type="button"
              class="rounded-2xl border border-slate-300 px-5 py-4 font-bold text-slate-800 transition hover:bg-slate-50"
            >
              Copy UPI ID
            </button>
          </div>

          <p
            id="status"
            class="mt-4 min-h-6 text-sm font-semibold text-slate-600"
            aria-live="polite"
          >
          </p>

          <div class="mt-8 rounded-2xl bg-slate-50 p-5">
            <p class="text-sm font-semibold text-slate-700">UPI ID</p>
            <p class="mt-1 break-all text-lg font-extrabold text-slate-900">
              {upiId}
            </p>
            <p class="mt-3 text-sm leading-6 text-slate-600">
              You can also open any supported UPI app, choose “Pay by UPI ID”,
              and enter this ID manually.
            </p>
          </div>

          <div
            class="mt-6 rounded-2xl border border-amber-200 bg-amber-50 p-5 text-sm leading-6 text-amber-900"
          >
            <strong>Please note:</strong> Keep your payment confirmation/screenshot.
            For an official donation receipt or tax documentation, contact the Trust
            using the contact details published on this website.
          </div>
        </div>

        <aside
          class="rounded-3xl border border-slate-200 bg-slate-50 p-6 text-center"
        >
          <h2 class="text-xl font-bold text-slate-900">Scan &amp; Pay</h2>
          <p class="mt-2 text-sm leading-6 text-slate-600">
            Scan this QR code with a supported UPI app. Enter your donation
            amount in the payment app.
          </p>

          <div
            class="mx-auto mt-6 flex max-w-xs justify-center rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-200"
          >
            <img
              src="/vasudhaiva-kulam-upi-qr.svg"
              alt="UPI QR code for Vasudhaiva Kulam Trust"
              width="280"
              height="280"
              class="h-auto w-full"
            />
          </div>

          <p class="mt-5 text-xs leading-5 text-slate-500">
            Payee: {payeeName}<br />
            UPI: {upiId}
          </p>

          <button
            id="share-qr-button"
            type="button"
            class="mt-6 inline-flex w-full items-center justify-center rounded-2xl bg-orange-600 px-5 py-4 font-bold text-white shadow-sm transition hover:bg-orange-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-orange-200"
          >
            Share / Download QR
          </button>

          <p class="mt-2 text-xs leading-5 text-slate-500">
            Share the QR directly or download it as an image to scan from your
            gallery.
          </p>
        </aside>
      </div>
    </section>
  </main>

  <script define:vars={{ upiId, payeeName, merchantCode, currency }}>
    const copyButton = document.getElementById("copy-button");
    const status = document.getElementById("status");
    const qrSvgUrl = "/vasudhaiva-kulam-upi-qr.svg";
    const shareButton = document.getElementById("share-qr-button");

    // Helper: Convert the SVG QR into a white-padded PNG File for UPI apps
    async function getQrPngFile() {
      const response = await fetch(qrSvgUrl);
      const svgText = await response.text();
      const svgBlob = new Blob([svgText], {
        type: "image/svg+xml;charset=utf-8",
      });
      const url = URL.createObjectURL(svgBlob);

      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => {
          const size = 1024;
          const padding = 64; // White quiet zone required by UPI gallery scanners
          const canvas = document.createElement("canvas");
          canvas.width = size;
          canvas.height = size;
          const ctx = canvas.getContext("2d");

          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, size, size);
          ctx.drawImage(
            img,
            padding,
            padding,
            size - padding * 2,
            size - padding * 2,
          );
          URL.revokeObjectURL(url);

          canvas.toBlob((blob) => {
            if (!blob) return reject(new Error("Canvas toBlob failed"));
            resolve(
              new File([blob], "vasudhaiva-kulam-upi-qr.png", {
                type: "image/png",
              }),
            );
          }, "image/png");
        };
        img.onerror = reject;
        img.src = url;
      });
    }

    // Share or Download PNG QR (Best on mobile for donations <= ₹2,000)
    async function shareOrDownloadQr() {
      try {
        const pngFile = await getQrPngFile();

        if (navigator.share && navigator.canShare?.({ files: [pngFile] })) {
          await navigator.share({
            title: `Donate to ${payeeName}`,
            text: `Scan this QR to donate to ${payeeName}, or pay using UPI ID: ${upiId}`,
            files: [pngFile],
          });

          setStatus("QR shared successfully.");
          return;
        }

        // Fallback: download the QR as a PNG
        const downloadUrl = URL.createObjectURL(pngFile);
        const a = document.createElement("a");

        a.href = downloadUrl;
        a.download = pngFile.name;
        document.body.appendChild(a);
        a.click();
        a.remove();

        // Allow the browser to begin the download before revoking the URL
        window.setTimeout(() => URL.revokeObjectURL(downloadUrl), 1000);

        setStatus("QR downloaded. You can now upload it from your gallery.");
      } catch (err) {
        if (err?.name === "AbortError") {
          setStatus("Sharing cancelled.");
        } else {
          console.error("Failed to share/download QR:", err);
          setStatus(
            "Unable to share or download the QR. Please try again.",
            true,
          );
        }
      }
    }

    function setStatus(message, error = false) {
      status.textContent = message;
      status.className = error
        ? "mt-4 min-h-6 text-sm font-semibold text-red-600"
        : "mt-4 min-h-6 text-sm font-semibold text-slate-600";
    }

    shareButton?.addEventListener("click", async () => {
      shareButton.disabled = true;

      try {
        await shareOrDownloadQr();
      } finally {
        shareButton.disabled = false;
      }
    });

    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(upiId);
        setStatus("UPI ID copied: " + upiId);
      } catch {
        setStatus(
          "Copy failed. Please copy this UPI ID manually: " + upiId,
          true,
        );
      }
    });
  </script></BaseLayout
>
