---
import { causes } from "../../data/causes";
import "../../styles/cause-pages.css";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return causes.map((cause) => ({
    params: { slug: cause.slug },
    props: { cause },
  }));
}

const { cause } = Astro.props;
const siteName = "Vasudhaiva Kulam";
const pageTitle = `${cause.name} - ${siteName}`;
const activityCount = cause.completed.length + cause.upcoming.length;
---

<BaseLayout title={pageTitle}>
  <main class={`cause-page cause-${cause.accent}`}>
    <!-- HERO -->
    <section class="cause-hero">
      <div class="cause-hero-inner">
        <a class="cause-back" href="/cause/">← All causes</a>

        <div class="cause-hero-grid">
          <div class="cause-hero-copy">
            <p class="cause-eyebrow">{cause.eyebrow}</p>

            <h1>{cause.title}</h1>

            <p class="cause-title-hindi">
              {cause.titleHindi}
            </p>

            <p class="cause-intro">
              {cause.intro}
            </p>

            <div class="cause-actions">
              <a class="cause-button cause-button-primary" href="#activities">
                See activities
              </a>

              <a class="cause-button cause-button-secondary" href="/join/">
                Volunteer
              </a>
            </div>
          </div>

          <figure class="cause-hero-media">
            <img
              src={cause.heroImage}
              alt={`${cause.name} activity`}
              loading="eager"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- FOCUS -->
    <section class="cause-section cause-section-white">
      <div class="cause-container">
        <div class="cause-section-header">
          <div>
            <p class="cause-kicker">OUR FOCUS</p>
            <h2>What we work on.</h2>
          </div>

          <p class="cause-section-note">
            A few practical areas where this cause takes shape.
          </p>
        </div>

        <div class="focus-list">
          {
            cause.focus.map((item, index) => (
              <article class="focus-item">
                <span class="focus-index">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div>
                  <h3>{item.label}</h3>

                  <p class="focus-hindi">{item.hindi}</p>

                  <p>{item.copy}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ACTIVITIES -->
    <section id="activities" class="cause-section cause-section-tint">
      <div class="cause-container">
        <div class="cause-section-header">
          <div>
            <p class="cause-kicker">ACTIVITY LOG</p>
            <h2>What we've done. What's next.</h2>
          </div>

          <p class="cause-section-note">
            {
              activityCount > 0
                ? `${activityCount} published activit${
                    activityCount === 1 ? "y" : "ies"
                  }.`
                : "Activities are added once their details are confirmed."
            }
          </p>
        </div>

        <div class="activity-columns">
          <!-- COMPLETED -->
          <section class="activity-group" aria-labelledby="completed-heading">
            <div class="activity-heading">
              <div>
                <span class="activity-status activity-status-complete">
                  Completed
                </span>
              </div>

              <span>{cause.completed.length} published</span>
            </div>

            {
              cause.completed.length > 0 ? (
                <div class="activity-list">
                  {cause.completed.map((activity) => (
                    <article class="activity-card">
                      <time class="activity-date">{activity.date}</time>

                      <div class="activity-body">
                        <h3>{activity.title}</h3>

                        {activity.location && (
                          <p class="activity-location">{activity.location}</p>
                        )}

                        <p>{activity.summary}</p>

                        {activity.href && (
                          <a href={activity.href}>Read more →</a>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <div class="activity-empty">
                  <strong>No completed activities yet.</strong>

                  <p>
                    Completed activities will appear here after they take place
                    and the details are ready to publish.
                  </p>
                </div>
              )
            }
          </section>

          <!-- UPCOMING -->
          <section class="activity-group" aria-labelledby="upcoming-heading">
            <div class="activity-heading">
              <div>
                <span class="activity-status activity-status-upcoming">
                  Upcoming
                </span>
              </div>

              <span>{cause.upcoming.length} announced</span>
            </div>

            {
              cause.upcoming.length > 0 ? (
                <div class="activity-list">
                  {cause.upcoming.map((activity) => (
                    <article class="activity-card">
                      <time class="activity-date">{activity.date}</time>

                      <div class="activity-body">
                        <h3>{activity.title}</h3>

                        {activity.location && (
                          <p class="activity-location">{activity.location}</p>
                        )}

                        <p>{activity.summary}</p>

                        {activity.href && <a href={activity.href}>Join →</a>}
                      </div>
                    </article>
                  ))}
                </div>
              ) : (
                <div class="activity-empty">
                  <strong>No upcoming activity announced.</strong>

                  <p>
                    We publish upcoming activities here once the date, location,
                    and basic details are confirmed.
                  </p>

                  <a href="/join/">Join the volunteer list →</a>
                </div>
              )
            }
          </section>
        </div>
      </div>
    </section>

    <!-- WAYS TO HELP -->
    <section class="cause-section cause-section-white">
      <div class="cause-container">
        <div class="cause-section-header">
          <div>
            <p class="cause-kicker">HOW TO HELP</p>
            <h2>Choose one useful thing.</h2>
          </div>

          <p class="cause-section-note">
            You don't need to do everything. Start with the kind of help that
            works for you.
          </p>
        </div>

        <div class="ways-grid">
          {
            cause.ways.map((way) => (
              <a class="way-item" href={way.href}>
                <div>
                  <h3>{way.title}</h3>
                  <p>{way.copy}</p>
                </div>

                <span aria-hidden="true">→</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cause-cta">
      <div class="cause-container">
        <div class="cause-cta-inner">
          <div>
            <p class="cause-kicker">
              {cause.name.toUpperCase()} / {cause.hindi}
            </p>

            <h2>{cause.ctaTitle}</h2>

            <p>{cause.ctaCopy}</p>
          </div>

          <div class="cause-cta-actions">
            <a class="cause-button cause-button-primary" href="/join/">
              Volunteer
            </a>

            <a class="cause-button cause-button-light" href="/donate/">
              Donate
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
